<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Habit Tracker</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap');
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0d0f1a;
    --surface: #141726;
    --surface2: #1c2035;
    --surface3: #232840;
    --border: #2a3055;
    --text: #e8ecf8;
    --text-muted: #6b7494;
    --text-dim: #4a5270;
    --accent: #7c6af7;
    --accent2: #5b9cf6;
    --accent3: #a78bfa;
    --green: #34d399;
    --pink: #f472b6;
    --yellow: #fbbf24;
    --red: #ef4444;
    --orange: #f97316;
  }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ── HEADER ── */
  .header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-left { display: flex; align-items: center; gap: 10px; }
  .header-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent3);
    letter-spacing: -0.3px;
  }
  .sync-indicator {
    font-size: 0.65rem;
    padding: 2px 8px;
    border-radius: 12px;
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .sync-indicator.synced { color: var(--green); border-color: rgba(52, 211, 153, 0.4); }
  .sync-indicator.syncing { color: var(--yellow); border-color: rgba(251, 191, 36, 0.4); }

  .header-controls { display: flex; gap: 8px; align-items: center; }
  .month-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    min-width: 130px;
    text-align: center;
  }
  .arrow-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1.2rem;
    padding: 4px 8px;
    border-radius: 6px;
    transition: color 0.15s;
    line-height: 1;
  }
  .arrow-btn:hover { color: var(--text); }

  /* ── STATS BAR ── */
  .stats-bar {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 12px 20px;
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scrollbar-width: none;
    align-items: center;
  }
  .stats-bar::-webkit-scrollbar { display: none; }
  .stat-item { display: flex; flex-direction: column; gap: 2px; white-space: nowrap; }
  .stat-label { font-size: 0.66rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .stat-value { font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 700; color: var(--text); }
  .stat-value.accent { color: var(--accent); }
  .stat-value.green  { color: var(--green); }
  .stat-value.yellow { color: var(--yellow); }

  /* ── MAIN GRID ── */
  .main { display: flex; flex: 1; overflow: auto; }

  /* ── HABIT SIDEBAR ── */
  .habit-sidebar {
    background: var(--surface);
    border-right: 1px solid var(--border);
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    left: 0;
    z-index: 10;
  }
  .sidebar-header {
    padding: 10px 14px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
  }
  .add-habit-btn {
    background: var(--accent);
    border: none;
    color: #fff;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s;
    flex-shrink: 0;
  }
  .add-habit-btn:hover { opacity: 0.8; }
  .habit-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px 0 14px;
    min-height: 38px;
    border-bottom: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
    user-select: none;
    position: relative;
  }
  .habit-row:hover { background: var(--surface2); }
  .habit-emoji { font-size: 0.9rem; flex-shrink: 0; }
  .habit-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .delete-habit-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 0.75rem;
    padding: 2px 4px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .habit-row:hover .delete-habit-btn { display: block; }
  .delete-habit-btn:hover { color: var(--pink); }
  .special-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px 0 14px;
    min-height: 38px;
    border-bottom: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  /* ── GRID AREA ── */
  .grid-area { flex: 1; overflow-x: auto; overflow-y: visible; }
  .week-headers {
    display: flex;
    position: sticky;
    top: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    z-index: 5;
    min-height: 44px;
  }
  .week-block-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 4px 0 4px 4px;
    border-right: 2px solid var(--border);
    flex-shrink: 0;
  }
  .week-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 0 6px 2px;
    color: var(--text-muted);
  }
  .day-headers { display: flex; }
  .day-header {
    width: 34px;
    text-align: center;
    font-size: 0.6rem;
    color: var(--text-dim);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding-bottom: 4px;
  }
  .day-header .dow { font-weight: 600; color: var(--text-muted); }
  .day-header .date-num { font-size: 0.65rem; font-weight: 700; }
  .day-header.today .date-num {
    background: var(--accent);
    color: #fff;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .day-header.future .date-num { color: var(--text-dim); opacity: 0.5; }

  /* ── CELLS ── */
  .grid-habit-row { display: flex; border-bottom: 1px solid var(--border); min-height: 38px; }
  .week-cells { display: flex; border-right: 2px solid var(--border); flex-shrink: 0; }
  .cell {
    width: 34px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .cell.future { cursor: not-allowed; }
  .cell.future:hover { background: transparent; }
  .cell.past { cursor: pointer; transition: background 0.1s; }
  .cell.past:hover { background: var(--surface2); }

  .check-box {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    border: 2px solid var(--border);
    transition: all 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
  }
  .cell.past:hover .check-box { border-color: var(--accent2); }
  .check-box.done { background: var(--accent); border-color: var(--accent); color: #fff; }
  .lock-icon { font-size: 0.55rem; color: var(--text-dim); opacity: 0.35; user-select: none; }

  /* Mood & Sleep */
  .mood-cell { width: 34px; height: 38px; display: flex; align-items: center; justify-content: center; }
  .mood-cell.past { cursor: pointer; }
  .mood-cell.future { cursor: not-allowed; }
  .mood-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--surface3);
    border: 2px solid var(--border);
    transition: all 0.15s;
  }
  .mood-dot.m1 { background: var(--red);    border-color: var(--red); }
  .mood-dot.m2 { background: var(--orange); border-color: var(--orange); }
  .mood-dot.m3 { background: var(--yellow); border-color: var(--yellow); }
  .mood-dot.m4 { background: var(--green);  border-color: var(--green); }
  .mood-dot.m5 { background: var(--accent); border-color: var(--accent); }

  .sleep-cell { width: 34px; height: 38px; display: flex; align-items: center; justify-content: center; }
  .sleep-cell.past { cursor: pointer; }
  .sleep-cell.future { cursor: not-allowed; }
  .sleep-num {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--text-dim);
    background: var(--surface3);
    border-radius: 4px;
    padding: 1px 3px;
    min-width: 16px;
    text-align: center;
    transition: all 0.15s;
  }
  .sleep-num.has-data { color: var(--accent2); background: rgba(91,156,246,0.15); }

  /* Week tints */
  .week-block-header[data-week="0"] { border-bottom: 2px solid rgba(124,106,247,0.5); }
  .week-block-header[data-week="1"] { border-bottom: 2px solid rgba(91,156,246,0.5); }
  .week-block-header[data-week="2"] { border-bottom: 2px solid rgba(167,139,250,0.5); }
  .week-block-header[data-week="3"] { border-bottom: 2px solid rgba(244,114,182,0.5); }

  /* ── CHARTS SECTION ── */
  .charts-section {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 20px;
    display: flex;
    gap: 28px;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .donut-wrap { display: flex; flex-direction: column; gap: 10px; flex-shrink: 0; }
  .donut-title { font-family: 'Space Grotesk', sans-serif; font-size: 0.72rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px; }
  .donut-container { position: relative; width: 120px; height: 120px; flex-shrink: 0; }
  .donut-svg { width: 120px; height: 120px; transform: rotate(-90deg); }
  .donut-bg { fill: none; stroke: var(--surface3); stroke-width: 12; }
  .donut-fill { fill: none; stroke-width: 12; stroke-linecap: round; transition: stroke-dashoffset 0.6s ease, stroke 0.4s; }
  .donut-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; }
  .donut-pct { font-family: 'Space Grotesk', sans-serif; font-size: 1.4rem; font-weight: 700; color: var(--text); line-height: 1; }
  .donut-sub { font-size: 0.6rem; color: var(--text-muted); }
  .donut-legend { display: flex; flex-direction: column; gap: 5px; align-self: center; }
  .legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.7rem; color: var(--text-muted); white-space: nowrap; }
  .legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .donut-row { display: flex; align-items: center; gap: 16px; }

  .bar-chart-wrap { flex: 1; min-width: 200px; display: flex; flex-direction: column; gap: 10px; }
  .bar-chart-title { font-family: 'Space Grotesk', sans-serif; font-size: 0.72rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px; }
  .bar-chart-inner { display: flex; align-items: flex-end; gap: 3px; height: 80px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
  .bar-chart-inner::-webkit-scrollbar { display: none; }
  .bar-col { display: flex; flex-direction: column; align-items: center; gap: 3px; flex-shrink: 0; width: 28px; }
  .bar-fill-wrap { width: 16px; background: var(--surface3); border-radius: 4px 4px 0 0; display: flex; align-items: flex-end; overflow: hidden; height: 64px; position: relative; }
  .bar-fill { width: 100%; border-radius: 4px 4px 0 0; transition: height 0.35s ease; position: absolute; bottom: 0; }
  .bar-fill.w0 { background: var(--surface3); height: 3px; border-radius: 3px; }
  .bar-fill.w1 { background: linear-gradient(180deg, var(--red) 0%, #c53030 100%); }
  .bar-fill.w2 { background: linear-gradient(180deg, var(--orange) 0%, #c05621 100%); }
  .bar-fill.w3 { background: linear-gradient(180deg, var(--yellow) 0%, #b7791f 100%); }
  .bar-fill.w4 { background: linear-gradient(180deg, var(--accent2) 0%, #2b6cb0 100%); }
  .bar-fill.w5 { background: linear-gradient(180deg, var(--green) 0%, #276749 100%); }
  .bar-fill.today-fill { box-shadow: 0 0 8px rgba(52,211,153,0.5); }
  .bar-day-lbl { font-size: 0.55rem; color: var(--text-dim); }

  /* ── MODALS & TOAST ── */
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.75); z-index: 200; display: none; align-items: center; justify-content: center; padding: 20px; }
  .modal-overlay.open { display: flex; }
  .modal { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; width: 100%; max-width: 360px; display: flex; flex-direction: column; gap: 16px; }
  .modal h2 { font-family: 'Space Grotesk', sans-serif; font-size: 1rem; font-weight: 700; color: var(--text); }
  .modal input { background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-family: 'Inter', sans-serif; font-size: 0.9rem; padding: 10px 12px; outline: none; transition: border-color 0.15s; width: 100%; }
  .modal input:focus { border-color: var(--accent); }
  .emoji-row { display: flex; flex-wrap: wrap; gap: 6px; }
  .emoji-pick { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 8px; background: var(--surface2); border: 2px solid var(--border); font-size: 1rem; cursor: pointer; transition: border-color 0.15s; }
  .emoji-pick.selected { border-color: var(--accent); background: rgba(124,106,247,0.15); }
  .modal-actions { display: flex; gap: 8px; }
  .btn-cancel { flex: 1; padding: 10px; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; color: var(--text-muted); font-family: 'Inter', sans-serif; font-size: 0.85rem; cursor: pointer; }
  .btn-add { flex: 1; padding: 10px; background: var(--accent); border: none; border-radius: 8px; color: #fff; font-family: 'Inter', sans-serif; font-size: 0.85rem; font-weight: 600; cursor: pointer; }

  .mood-picker, .sleep-picker { position: fixed; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; z-index: 300; display: none; box-shadow: 0 8px 24px rgba(0,0,0,0.5); }
  .mood-picker { padding: 8px; gap: 6px; }
  .mood-picker.open { display: flex; }
  .mood-option { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1.1rem; }
  .mood-option:hover { background: var(--surface3); }

  .sleep-picker { padding: 10px 12px; flex-direction: column; gap: 6px; }
  .sleep-picker.open { display: flex; }
  .sleep-picker label { font-size: 0.7rem; color: var(--text-muted); }
  .sleep-picker input[type=range] { width: 130px; accent-color: var(--accent2); }
  .sleep-value { font-size: 0.85rem; font-weight: 700; color: var(--accent2); text-align: center; }
  .sleep-set-btn { background: var(--accent2); border: none; border-radius: 6px; color: #fff; font-size: 0.75rem; font-weight: 600; padding: 6px 10px; cursor: pointer; }

  .toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(60px); background: var(--surface3); border: 1px solid var(--border); border-left: 3px solid var(--red); color: var(--text); font-size: 0.8rem; padding: 8px 16px; border-radius: 8px; z-index: 400; opacity: 0; transition: transform 0.25s ease, opacity 0.25s ease; pointer-events: none; white-space: nowrap; }
  .toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

  @media (max-width: 640px) {
    .habit-sidebar { width: 140px; }
    .header-title { font-size: 0.9rem; }
    .stats-bar { gap: 14px; padding: 10px 14px; }
    .stat-value { font-size: 1rem; }
    .cell, .day-header, .mood-cell, .sleep-cell { width: 28px; }
    .charts-section { gap: 20px; padding: 16px; }
    .donut-container { width: 100px; height: 100px; }
    .donut-svg { width: 100px; height: 100px; }
    .donut-pct { font-size: 1.1rem; }
  }

  @keyframes flash { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
  .cell.flash { animation: flash 0.2s ease; }
</style>

<!-- Firebase SDKs for Cloud Sync -->
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-firestore-compat.js"></script>
</head>
<body>

<header class="header">
  <div class="header-left">
    <span class="header-title">🎮 My Habits</span>
    <span class="sync-indicator" id="syncStatus">Cloud Sync: Connecting...</span>
  </div>
  <div class="header-controls">
    <button class="arrow-btn" id="prevMonth">‹</button>
    <span class="month-label" id="monthLabel"></span>
    <button class="arrow-btn" id="nextMonth">›</button>
  </div>
</header>

<div class="stats-bar">
  <div class="stat-item">
    <span class="stat-label">Habits</span>
    <span class="stat-value accent" id="totalHabits">0</span>
  </div>
  <div class="stat-item">
    <span class="stat-label">Done Today</span>
    <span class="stat-value green" id="doneToday">0</span>
  </div>
  <div class="stat-item">
    <span class="stat-label">Completed</span>
    <span class="stat-value" id="totalCompleted">0</span>
  </div>
  <div class="stat-item">
    <span class="stat-label">Streak</span>
    <span class="stat-value yellow" id="bestStreak">0🔥</span>
  </div>
</div>

<div class="main" id="mainArea">
  <div class="habit-sidebar" id="habitSidebar">
    <div class="sidebar-header">
      <span>My Habits</span>
      <button class="add-habit-btn" id="openModal" title="Add habit">+</button>
    </div>
    <div class="special-row"><span class="habit-emoji">😊</span><span class="habit-name">Mood</span></div>
    <div class="special-row"><span class="habit-emoji">😴</span><span class="habit-name">Sleep (hrs)</span></div>
  </div>
  <div class="grid-area" id="gridArea"></div>
</div>

<!-- CHARTS -->
<div class="charts-section">
  <div class="donut-wrap">
    <div class="donut-title">Monthly Progress</div>
    <div class="donut-row">
      <div class="donut-container">
        <svg class="donut-svg" viewBox="0 0 120 120">
          <circle class="donut-bg" cx="60" cy="60" r="48"/>
          <circle class="donut-fill" id="donutFill" cx="60" cy="60" r="48"
            stroke="var(--accent)"
            stroke-dasharray="301.59"
            stroke-dashoffset="301.59"/>
        </svg>
        <div class="donut-center">
          <span class="donut-pct" id="donutPct">0%</span>
          <span class="donut-sub" id="donutSub">of month</span>
        </div>
      </div>
      <div class="donut-legend">
        <div class="legend-item"><div class="legend-dot" style="background:var(--accent)"></div><span id="legendDone">0 done</span></div>
        <div class="legend-item"><div class="legend-dot" style="background:var(--surface3);border:1px solid var(--border)"></div><span id="legendLeft">0 left</span></div>
        <div class="legend-item"><div class="legend-dot" style="background:var(--text-dim);opacity:0.4"></div><span id="legendFuture">0 future</span></div>
      </div>
    </div>
  </div>

  <div class="bar-chart-wrap">
    <div class="bar-chart-title">Daily Progress</div>
    <div class="bar-chart-inner" id="barChart"></div>
  </div>
</div>

<!-- MODALS -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <h2>Add a habit</h2>
    <div class="emoji-row" id="emojiRow"></div>
    <input type="text" id="habitNameInput" placeholder="Habit name..." maxlength="30" />
    <div class="modal-actions">
      <button class="btn-cancel" id="closeModal">Cancel</button>
      <button class="btn-add" id="confirmAdd">Add Habit</button>
    </div>
  </div>
</div>

<div class="mood-picker" id="moodPicker">
  <div class="mood-option" data-mood="1" title="Bad">😞</div>
  <div class="mood-option" data-mood="2" title="Meh">😐</div>
  <div class="mood-option" data-mood="3" title="Okay">🙂</div>
  <div class="mood-option" data-mood="4" title="Good">😊</div>
  <div class="mood-option" data-mood="5" title="Great">🤩</div>
</div>

<div class="sleep-picker" id="sleepPicker">
  <label>Hours of sleep</label>
  <input type="range" id="sleepRange" min="0" max="12" step="0.5" value="7">
  <div class="sleep-value" id="sleepValue">7 hrs</div>
  <button class="sleep-set-btn" id="sleepSetBtn">Set</button>
</div>

<div class="toast" id="toast">Can't check future dates</div>

<script>
// ── YOUR FIREBASE CONFIGURATION ──
