// ── STATE ──
const STORAGE_KEY = 'habitTrackerData_v3';
function loadLocal() {
  try { const r = localStorage.getItem(STORAGE_KEY); return r ? JSON.parse(r) : null; }
  catch { return null; }
}
function saveLocal() { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }

const defaultHabits = [
  { id:1, name:'Wake up at 05:00', emoji:'⏰' },
  { id:2, name:'Gym',              emoji:'💪' },
  { id:3, name:'Reading / Learning', emoji:'📚' },
  { id:4, name:'Day Planning',     emoji:'📅' },
  { id:5, name:'Project Work',     emoji:'🎯' },
  { id:6, name:'No Social Media',  emoji:'🌿' },
  { id:7, name:'Goal Journaling',  emoji:'📝' },
  { id:8, name:'Cold Shower',      emoji:'🚿' },
];

let state = loadLocal() || {
  habits: defaultHabits, nextId: 100,
  checks: {}, moods: {}, sleep: {},
  viewYear: new Date().getFullYear(),
  viewMonth: new Date().getMonth(),
};

function setSyncStatus(msg, statusClass) {
  const el = document.getElementById('syncStatus');
  if (!el) return;
  el.textContent = msg;
  el.className = 'sync-indicator ' + (statusClass || '');
}

// Save to LocalStorage + Firestore Cloud Database
let saveDebounceTimer;
function saveState() {
  saveLocal();
  if (useCloud && db) {
    setSyncStatus('Syncing...', 'syncing');
    clearTimeout(saveDebounceTimer);
    saveDebounceTimer = setTimeout(() => {
      db.collection('habitTracker').doc('shared_state').set({
        habits: state.habits,
        nextId: state.nextId,
        checks: state.checks,
        moods: state.moods,
        sleep: state.sleep
      }, { merge: true })
      .then(() => setSyncStatus('☁️ Live Synced', 'synced'))
      .catch(err => {
        console.error("Cloud save error:", err);
        setSyncStatus('Sync Failed', '');
      });
    }, 300);
  }
}

// Realtime Listener for Mobile/Laptop instant updates
function initCloudSync() {
  if (!useCloud || !db) return;
  setSyncStatus('Connecting...', 'syncing');
  db.collection('habitTracker').doc('shared_state')
    .onSnapshot((doc) => {
      if (doc.exists) {
        const cloudData = doc.data();
        state.habits = cloudData.habits || state.habits;
        state.nextId = cloudData.nextId || state.nextId;
        state.checks = cloudData.checks || {};
        state.moods = cloudData.moods || {};
        state.sleep = cloudData.sleep || {};
        saveLocal();
        render();
        setSyncStatus('☁️ Live Synced', 'synced');
      } else {
        saveState();
      }
    }, (err) => {
      console.error("Cloud sync listen error:", err);
      setSyncStatus('Sync Error', '');
    });
}

// ── DATE HELPERS ──
const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const DOW = ['Su','Mo','Tu','We','Th','Fr','Sa'];

function today() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}
function daysInMonth(y,m) { return new Date(y, m+1, 0).getDate(); }
function dateStr(y,m,d) { return `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`; }

function buildWeeks(y,m) {
  const total = daysInMonth(y,m);
  const weeks = []; let week = [];
  for (let d = 1; d <= total; d++) {
    const dt = new Date(y,m,d);
    week.push({ day:d, dow:dt.getDay(), ds:dateStr(y,m,d) });
    if (dt.getDay() === 6 || d === total) { weeks.push(week); week = []; }
  }
  return weeks;
}

// ── TOAST ──
let toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
}

// ── RENDER ──
function render() {
  state.viewYear  = state.viewYear  || new Date().getFullYear();
  state.viewMonth = state.viewMonth ?? new Date().getMonth();

  document.getElementById('monthLabel').textContent = `${MONTH_NAMES[state.viewMonth]} ${state.viewYear}`;

  const weeks = buildWeeks(state.viewYear, state.viewMonth);
  const todayStr = today();

  const sidebar = document.getElementById('habitSidebar');
  sidebar.querySelectorAll('.habit-row').forEach(r => r.remove());
  const refNode = sidebar.querySelector('.special-row');
  state.habits.forEach(habit => {
    const row = document.createElement('div');
    row.className = 'habit-row';
    row.dataset.id = habit.id;
    row.innerHTML = `
      <span class="habit-emoji">${habit.emoji}</span>
      <span class="habit-name">${habit.name}</span>
      <button class="delete-habit-btn" data-id="${habit.id}" title="Remove">✕</button>`;
    sidebar.insertBefore(row, refNode);
  });

  const grid = document.getElementById('gridArea');
  grid.innerHTML = '';

  const weekHeaders = document.createElement('div');
  weekHeaders.className = 'week-headers';
  weeks.forEach((wk, wi) => {
    const wh = document.createElement('div');
    wh.className = 'week-block-header';
    wh.dataset.week = wi;
    const wLbl = document.createElement('div');
    wLbl.className = 'week-label';
    wLbl.textContent = `Week ${wi+1}`;
    const dh = document.createElement('div');
    dh.className = 'day-headers';
    wk.forEach(({ day, dow, ds }) => {
      const d = document.createElement('div');
      const isFuture = ds > todayStr;
      d.className = 'day-header' + (ds === todayStr ? ' today' : '') + (isFuture ? ' future' : '');
      d.innerHTML = `<span class="dow">${DOW[dow]}</span><span class="date-num">${day}</span>`;
      dh.appendChild(d);
    });
    wh.appendChild(wLbl);
    wh.appendChild(dh);
    weekHeaders.appendChild(wh);
  });
  grid.appendChild(weekHeaders);

  // Habit rows
  state.habits.forEach(habit => {
    const row = document.createElement('div');
    row.className = 'grid-habit-row';
    weeks.forEach((wk, wi) => {
      const wCells = document.createElement('div');
      wCells.className = 'week-cells';
      wCells.dataset.week = wi;
      wk.forEach(({ ds }) => {
        const cell = document.createElement('div');
        const isFuture = ds > todayStr;
        cell.className = 'cell ' + (isFuture ? 'future' : 'past');
        cell.dataset.ds = ds;
        cell.dataset.habitId = habit.id;
        if (isFuture) {
          const lk = document.createElement('span');
          lk.className = 'lock-icon';
          lk.textContent = '🔒';
          cell.appendChild(lk);
        } else {
          const done = !!state.checks[`${ds}:${habit.id}`];
          const box = document.createElement('div');
          box.className = 'check-box' + (done ? ' done' : '');
          box.textContent = done ? '✓' : '';
          cell.appendChild(box);
        }
        wCells.appendChild(cell);
      });
      row.appendChild(wCells);
    });
    grid.appendChild(row);
  });

  // Mood row
  const moodRow = document.createElement('div');
  moodRow.className = 'grid-habit-row';
  weeks.forEach((wk, wi) => {
    const wCells = document.createElement('div');
    wCells.className = 'week-cells';
    wCells.dataset.week = wi;
    wk.forEach(({ ds }) => {
      const cell = document.createElement('div');
      const isFuture = ds > todayStr;
      cell.className = 'mood-cell ' + (isFuture ? 'future' : 'past');
      cell.dataset.ds = ds;
      if (!isFuture) {
        const m = state.moods[ds];
        const dot = document.createElement('div');
        dot.className = 'mood-dot' + (m ? ` m${m}` : '');
        cell.appendChild(dot);
      }
      wCells.appendChild(cell);
    });
    moodRow.appendChild(wCells);
  });
  grid.appendChild(moodRow);

  // Sleep row
  const sleepRow = document.createElement('div');
  sleepRow.className = 'grid-habit-row';
  weeks.forEach((wk, wi) => {
    const wCells = document.createElement('div');
    wCells.className = 'week-cells';
    wCells.dataset.week = wi;
    wk.forEach(({ ds }) => {
      const cell = document.createElement('div');
      const isFuture = ds > todayStr;
      cell.className = 'sleep-cell ' + (isFuture ? 'future' : 'past');
      cell.dataset.ds = ds;
      if (!isFuture) {
        const s = state.sleep[ds];
        const num = document.createElement('div');
        num.className = 'sleep-num' + (s != null ? ' has-data' : '');
        num.textContent = s != null ? s : '—';
        cell.appendChild(num);
      }
      wCells.appendChild(cell);
    });
    sleepRow.appendChild(wCells);
  });
  grid.appendChild(sleepRow);

  updateStats(weeks, todayStr);
  renderCharts(weeks, todayStr);
}

function updateStats(weeks, todayStr) {
  const y = state.viewYear, m = state.viewMonth;
  const total = daysInMonth(y, m);
  let totalCompleted = 0, doneToday = 0;
  for (let d = 1; d <= total; d++) {
    const ds = dateStr(y, m, d);
    if (ds > todayStr) continue;
    state.habits.forEach(h => {
      if (state.checks[`${ds}:${h.id}`]) {
        totalCompleted++;
        if (ds === todayStr) doneToday++;
      }
    });
  }

  let streak = 0;
  const dd = new Date(todayStr);
  for (let i = 0; i < 365; i++) {
    const ds = dd.toISOString().split('T')[0];
    const done = state.habits.filter(h => state.checks[`${ds}:${h.id}`]).length;
    if (state.habits.length && done === state.habits.length) { streak++; dd.setDate(dd.getDate()-1); }
    else break;
  }

  document.getElementById('totalHabits').textContent = state.habits.length;
  document.getElementById('doneToday').textContent   = doneToday;
  document.getElementById('totalCompleted').textContent = totalCompleted;
  document.getElementById('bestStreak').textContent  = streak + '🔥';
}

function renderCharts(weeks, todayStr) {
  const allDays = weeks.flat();
  const y = state.viewYear, m = state.viewMonth;
  const hn = state.habits.length;

  let doneCells = 0, possibleCells = 0, futureCells = 0;
  allDays.forEach(({ ds }) => {
    if (ds > todayStr) { futureCells += hn; return; }
    possibleCells += hn;
    state.habits.forEach(h => { if (state.checks[`${ds}:${h.id}`]) doneCells++; });
  });
  const missed = possibleCells - doneCells;

  const pct = possibleCells > 0 ? Math.round(doneCells / possibleCells * 100) : 0;
  const circumference = 2 * Math.PI * 48;
  const offset = circumference - (pct / 100) * circumference;

  const donutFill = document.getElementById('donutFill');
  donutFill.style.strokeDashoffset = offset;
  const strokeColor = pct >= 80 ? 'var(--green)' : pct >= 50 ? 'var(--accent2)' : pct >= 25 ? 'var(--yellow)' : 'var(--red)';
  donutFill.style.stroke = strokeColor;

  document.getElementById('donutPct').textContent = pct + '%';
  document.getElementById('donutSub').textContent = MONTH_NAMES[m].slice(0,3);
  document.getElementById('legendDone').textContent   = doneCells + ' done';
  document.getElementById('legendLeft').textContent   = missed + ' missed';
  document.getElementById('legendFuture').textContent = futureCells + ' future';

  const chart = document.getElementById('barChart');
  chart.innerHTML = '';

  allDays.forEach(({ day, ds }) => {
    if (ds > todayStr) return;
    const done = hn ? state.habits.filter(h => state.checks[`${ds}:${h.id}`]).length : 0;
    const pctDay = hn ? done / hn : 0;
    const isToday = ds === todayStr;

    const barH = Math.max(3, Math.round(pctDay * 60));
    let tier = 'w0';
    if (pctDay >= 1)    tier = 'w5';
    else if (pctDay >= 0.75) tier = 'w4';
    else if (pctDay >= 0.5)  tier = 'w3';
    else if (pctDay >= 0.25) tier = 'w2';
    else if (pctDay > 0)     tier = 'w1';

    const col = document.createElement('div');
    col.className = 'bar-col';
    const wrap = document.createElement('div');
    wrap.className = 'bar-fill-wrap';
    const fill = document.createElement('div');
    fill.className = `bar-fill ${tier}` + (isToday ? ' today-fill' : '');
    fill.style.height = barH + 'px';
    fill.title = `${ds}: ${Math.round(pctDay*100)}%`;

    wrap.appendChild(fill);
    const lbl = document.createElement('div');
    lbl.className = 'bar-day-lbl';
    lbl.textContent = day;

    col.appendChild(wrap);
    col.appendChild(lbl);
    chart.appendChild(col);
  });
  chart.scrollLeft = chart.scrollWidth;
}

// ── EVENTS ──
document.getElementById('gridArea').addEventListener('click', e => {
  const cell = e.target.closest('.cell');
  if (!cell) return;
  if (cell.classList.contains('future')) {
    showToast("🔒 Can't check future dates");
    return;
  }
  const ds = cell.dataset.ds;
  const id = parseInt(cell.dataset.habitId);
  const key = `${ds}:${id}`;
  state.checks[key] = !state.checks[key];
  if (!state.checks[key]) delete state.checks[key];
  saveState();
  cell.classList.add('flash');
  setTimeout(() => cell.classList.remove('flash'), 200);
  render();
});

let moodTarget = null;
document.getElementById('gridArea').addEventListener('click', e => {
  const cell = e.target.closest('.mood-cell');
  if (!cell) return;
  if (cell.classList.contains('future')) { showToast("🔒 Can't set mood for future dates"); return; }
  moodTarget = cell.dataset.ds;
  const picker = document.getElementById('moodPicker');
  const rect = cell.getBoundingClientRect();
  picker.style.left = Math.min(rect.left, window.innerWidth - 210) + 'px';
  picker.style.top  = (rect.bottom + 4) + 'px';
  picker.classList.add('open');
});

document.getElementById('moodPicker').addEventListener('click', e => {
  const opt = e.target.closest('.mood-option');
  if (!opt || !moodTarget) return;
  state.moods[moodTarget] = parseInt(opt.dataset.mood);
  saveState();
  document.getElementById('moodPicker').classList.remove('open');
  render();
});

let sleepTarget = null;
document.getElementById('gridArea').addEventListener('click', e => {
  const cell = e.target.closest('.sleep-cell');
  if (!cell) return;
  if (cell.classList.contains('future')) { showToast("🔒 Can't log sleep for future dates"); return; }
  sleepTarget = cell.dataset.ds;
  const picker = document.getElementById('sleepPicker');
  const rect = cell.getBoundingClientRect();
  picker.style.left = Math.min(rect.left, window.innerWidth - 165) + 'px';
  picker.style.top  = (rect.bottom + 4) + 'px';
  const cur = state.sleep[sleepTarget] ?? 7;
  document.getElementById('sleepRange').value = cur;
  document.getElementById('sleepValue').textContent = cur + ' hrs';
  picker.classList.add('open');
});
document.getElementById('sleepRange').addEventListener('input', e => {
  document.getElementById('sleepValue').textContent = e.target.value + ' hrs';
});
document.getElementById('sleepSetBtn').addEventListener('click', () => {
  if (sleepTarget == null) return;
  state.sleep[sleepTarget] = parseFloat(document.getElementById('sleepRange').value);
  saveState();
  document.getElementById('sleepPicker').classList.remove('open');
  render();
});

document.addEventListener('click', e => {
  const mp = document.getElementById('moodPicker');
  const sp = document.getElementById('sleepPicker');
  if (!mp.contains(e.target) && !e.target.closest('.mood-cell'))  mp.classList.remove('open');
  if (!sp.contains(e.target) && !e.target.closest('.sleep-cell')) sp.classList.remove('open');
});

document.getElementById('prevMonth').addEventListener('click', () => {
  if (state.viewMonth === 0) { state.viewMonth = 11; state.viewYear--; }
  else state.viewMonth--;
  saveLocal(); render();
});
document.getElementById('nextMonth').addEventListener('click', () => {
  if (state.viewMonth === 11) { state.viewMonth = 0; state.viewYear++; }
  else state.viewMonth++;
  saveLocal(); render();
});

document.getElementById('habitSidebar').addEventListener('click', e => {
  const btn = e.target.closest('.delete-habit-btn');
  if (!btn) return;
  state.habits = state.habits.filter(h => h.id !== parseInt(btn.dataset.id));
  saveState(); render();
});

const EMOJIS = ['⏰','💪','📚','📅','🎯','🌿','📝','🚿','🍎','💧','🧘','🏃','🛌','💰','🎮','🎸','✍️','🧹','🥗','☀️','🌙','🔥','❤️','🧠'];
let selectedEmoji = '⏰';

document.getElementById('openModal').addEventListener('click', () => {
  const row = document.getElementById('emojiRow');
  row.innerHTML = '';
  EMOJIS.forEach(em => {
    const btn = document.createElement('div');
    btn.className = 'emoji-pick' + (em === selectedEmoji ? ' selected' : '');
    btn.textContent = em;
    btn.addEventListener('click', () => {
      selectedEmoji = em;
      row.querySelectorAll('.emoji-pick').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
    });
    row.appendChild(btn);
  });
  document.getElementById('habitNameInput').value = '';
  document.getElementById('modalOverlay').classList.add('open');
  setTimeout(() => document.getElementById('habitNameInput').focus(), 100);
});
document.getElementById('closeModal').addEventListener('click', () =>
  document.getElementById('modalOverlay').classList.remove('open'));
document.getElementById('modalOverlay').addEventListener('click', e => {
  if (e.target === document.getElementById('modalOverlay'))
    document.getElementById('modalOverlay').classList.remove('open');
});
document.getElementById('confirmAdd').addEventListener('click', () => {
  const name = document.getElementById('habitNameInput').value.trim();
  if (!name) return;
  state.habits.push({ id: state.nextId++, name, emoji: selectedEmoji });
  saveState();
  document.getElementById('modalOverlay').classList.remove('open');
  render();
});
document.getElementById('habitNameInput').addEventListener('keydown', e => {
  if (e.key === 'Enter') document.getElementById('confirmAdd').click();
});

// ── INIT ──
render();
initCloudSync();
</script>
